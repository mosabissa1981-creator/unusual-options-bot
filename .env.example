# Optional: paste a Discord webhook URL to get alerts in a channel
DISCORD_WEBHOOK_URL=

# Telegram bot token from @BotFather (best for iPhone)
TELEGRAM_BOT_TOKEN=

# Comma-separated tickers to scan
WATCHLIST=SPY,QQQ,AAPL,NVDA,TSLA,AMZN,META,MSFT

# Unusualness thresholds
MIN_VOLUME=500
MIN_OPEN_INTEREST=100
MIN_VOL_OI_RATIO=3.0
MIN_PREMIUM=100000
MAX_EXPIRIES=3

# Mobile web app
WEB_HOST=0.0.0.0
WEB_PORT=8080
